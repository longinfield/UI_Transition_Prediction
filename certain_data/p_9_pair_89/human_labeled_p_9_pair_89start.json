_label": 0}, {"id": 10, "class": "Text", "height": 187, "width": 375, "position": {"column_min": 25, "row_min": 141, "column_max": 400, "row_max": 328}, "text_content": "Astigmatism is a vision condition that causes blurred\nvision due either to the irregular shape of the cornea , the\nclear front cover of the eye , or sometimes the curvature of\nthe lens inside the eye . In this case the cornea is not fully a\ncircular dome , but it is shaped more like a football .\nAstigmatism makes it difficult to see fine details , either\nclose up or from a distance . If you have uncorrected\nastigmatism , you can have various symptoms such as\nblurry vision , eyestrain , tired eyes or headaches .\nAstigmatism can be quickly and easily corrected with\neyeglasses , astigmatic contact lenses or laser surgery .", "parent": 0, "label": 0, "human_label": 0}, {"id": 11, "class": "Text", "height": 12, "width": 295, "position": {"column_min": 69, "row_min": 548, "column_max": 364, "row_max": 560}, "text_content": "UNLOCK ALL PRO TESTS AND REMOVE ADS", "label": 0, "human_label": 0}], "img_shape": [768, 432, 3]}