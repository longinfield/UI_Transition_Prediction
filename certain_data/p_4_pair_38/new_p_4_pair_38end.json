 "column_max": 73, "row_max": 116}, "text_content": "THEORY"}, {"id": 12, "class": "Text", "height": 13, "width": 86, "position": {"column_min": 97, "row_min": 103, "column_max": 183, "row_max": 116}, "text_content": "DICTIONARY"}, {"id": 13, "class": "Text", "height": 15, "width": 82, "position": {"column_min": 17, "row_min": 169, "column_max": 99, "row_max": 184}, "text_content": "Intervals"}, {"id": 14, "class": "Text", "height": 93, "width": 400, "position": {"column_min": 16, "row_min": 203, "column_max": 416, "row_max": 296}, "text_content": "An interval is simply the distance between two notes\npitches . If you have ever played any two notes on a musical\ninstrument then you have played intervals . When you play or\nsing any two notes on your instrument you have created and\nused an interval .\nor"}, {"id": 15, "class": "Text", "height": 13, "width": 134, "position": {"column_min": 16, "row_min": 311, "column_max": 150, "row_max": 324}, "text_content": "There are 12 notes"}, {"id": 16, "class": "Text", "height": 13, "width": 9, "position": {"column_min": 160, "row_min": 311, "column_max": 169, "row_max": 324}, "text_content": "in"}, {"id": 17, "class": "Text", "height": 13, "width": 14, "position": {"column_min": 180, "row_min": 311, "column_max": 194, "row_max": 324}, "text_content": "an"}, {"id": 18, "class": "Text", "height": 13, "width": 42, "position": {"column_min": 204, "row_min": 311, "column_max": 246, "row_max": 324}, "text_content": "octave"}, {"id": 19, "class": "Text", "height": 13, "width": 158, "position": {"column_min": 258, "row_min": 311, "column_max": 416, "row_max": 324}, "text_content": "therefore , there are 13"}, {"id": 20, "class": "Text", "height": 14, "width": 400, "position": {"column_min": 16, "row_min": 331, "column_max": 416, "row_max": 345}, "text_content": "simple intervals . The names for each of the 13 intervals will"}, {"id": 21, "class": "Text", "height": 12, "width": 250, "position": {"column_min": 16, "row_min": 352, "column_max": 266, "row_max": 364}, "text_content": "be discussed little later in this section ."}, {"id": 22, "class": "Text", "height": 17, "width": 119, "position": {"column_min": 16, "row_min": 378, "column_max": 135, "row_max": 395}, "text_content": "Types of intervals :"}, {"id": 23, "class": "Text", "height": 14, "width": 310, "position": {"column_min": 38, "row_min": 415, "column_max": 348, "row_max": 429}, "text_content": "1. Harmonic Interval : two notes that are played"}, {"id": 24, "class": "Text", "height": 32, "width": 351, "position": {"column_min": 58, "row_min": 436, "column_max": 409, "row_max": 468}, "text_content": "simultaneously or at the same time .\nMelodic Interval : two notes that are played separately"}, {"id": 25, "class": "Text", "height": 14, "width": 11, "position": {"column_min": 38, "row_min": 453, "column_max": 49, "row_max": 467}, "text_content": "2."}, {"id": 26, "class": "Text", "height": 11, "width": 142, "position": {"column_min": 59, "row_min": 475, "column_max": 201, "row_max": 486}, "text_content": "or one after the other ."}, {"id": 27, "class": "Text", "height": 12, "width": 384, "position": {"column_min": 16, "row_min": 510, "column_max": 400, "row_max": 522}, "text_content": "There are two characteristics of an interval that are used to"}, {"id": 28, "class": "Text", "height": 14, "width": 142, "position": {"column_min": 16, "row_min": 529, "column_max": 158, "row_max": 543}, "text_content": "determine its identity :"}, {"id": 29, "class": "Text", "height": 34, "width": 77, "position": {"column_min": 37, "row_min": 565, "column_max": 114, "row_max": 599}, "text_content": "1. Quantity\n2. Quality"}, {"id": 30, "class": "Text", "height": 14, "width": 64, "position": {"column_min": 17, "row_min": 637, "column_max": 81, "row_max": 651}, "text_content": "Quantity"}, {"id": 31, "class": "Text", "height": 34, "width": 402, "position": {"column_min": 15, "row_min": 670, "column_max": 417, "row_max": 704}, "text_content": "The quantity of an interval indicates the distance between\ntwo notes . For example , consider the notes : A and C. The"}], "img_shape": [768, 432, 3]}