turation should be reported to your doctor .", "parent": 0, "label": 0, "human_label": 0}, {"id": 8, "class": "Text", "height": 12, "width": 295, "position": {"column_min": 68, "row_min": 372, "column_max": 363, "row_max": 384}, "text_content": "UNLOCK ALL PRO TESTS AND REMOVE ADS", "label": 0, "human_label": 1}], "img_shape": [768, 432, 3]}